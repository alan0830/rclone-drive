{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RcloneDrive",
  "version": "1.0.0",
  "identifier": "com.rclonedrive.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rclone Drive - 雲端硬碟掛載器",
        "width": 980,
        "height": 700,
        "minWidth": 800,
        "minHeight": 580,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
